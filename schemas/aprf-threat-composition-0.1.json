{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stackrail.io/aprf/threat-composition-schema/0.1",
  "title": "AprfThreatComposition",
  "description": "APRF threat-first composition definitions (APRF-RFC-0014).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "threats"],
  "properties": {
    "id": { "type": "string", "const": "aprf-threat-composition" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "aprfVersion": { "type": "string" },
    "disclaimer": { "type": "string" },
    "threats": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/threatDef" }
    }
  },
  "$defs": {
    "threatDef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "severityHint", "description", "indicators", "mitigations"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "severityHint": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low"]
        },
        "description": { "type": "string", "minLength": 1 },
        "displayThreats": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "indicators": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/indicator" }
        },
        "mitigations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/mitigation" }
        }
      }
    },
    "mitigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkId", "role"],
      "properties": {
        "checkId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "role": { "type": "string", "enum": ["primary", "supporting"] }
      }
    },
    "indicator": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["signal"],
          "properties": {
            "signal": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_]*)+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["allOf"],
          "properties": {
            "allOf": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/indicator" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["anyOf"],
          "properties": {
            "anyOf": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/indicator" }
            }
          }
        }
      ]
    }
  }
}
